# ============================================================
# هوش (Hoosh) — نمونهٔ متغیرهای محیطی
# این فایل را به .env کپی کنید و مقادیر واقعی را قرار دهید.
# ============================================================

# ---------- ضروری ----------
# آدرس پایگاه داده (SQLite توسعه / PostgreSQL تولید)
DATABASE_URL="file:./db/custom.db"
# مثال PostgreSQL تولید:
# DATABASE_URL="postgresql://user:pass@localhost:5432/hoosh?schema=public"

# راز امضای JWT — روی سرور اصلی الزامی است (openssl rand -hex 32)
JWT_SECRET=""

# ---------- اختیاری: حالت دمو ----------
# فقط برای سرور دمو عمومی؛ در تولید خالی/حذف بمانید
DEMO_MODE=""

# ---------- اختیاری: پرداخت زرین‌پال ----------
# ZARINPAL_MERCHANT_ID=""
# ZARINPAL_CALLBACK_URL="https://hoosh.nobatime.ir/api/payment/callback"

# ---------- اختیاری: اعلان پوش (PWA) ----------
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:info@hoosh.nobatime.ir"

# ---------- اختیاری: ایمیل SMTP ----------
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Hoosh <no-reply@hoosh.nobatime.ir>"

# ---------- اختیاری: پیامک ----------
# SMS_PROVIDER=""
# SMS_API_KEY=""
# SMS_SENDER=""

# ---------- اختیاری: راز‌های cron داخلی ----------
# CRON_SECRET=""
# ANOMALY_CRON_SECRET=""

# ---------- اختیاری: پنل پیام رسان (چت) ----------
# TELEGRAM_BOT_TOKEN=""
# CHAT_INTERNAL_SECRET=""

# ---------- توسعه در سندباکس کم‌حافظه ----------
# سرور dev را با اسکریپت watchdog اجرا کنید (توصیهٔ سندباکس ۴GB):
#   bash start-dev.sh
# NODE_OPTIONS="--max-old-space-size=1024"
# TURBOPACK_MAX_WORKERS=1
